  "narrative": {
    "northStar": "The Focused Workspace",
    "overview": "The focused workspace uses deep navy for orientation, lavender for selection and guided starting points, and mint for small identity and learning cues. Its character is calm, direct, and practical: clear controls surround a generous working surface.\n\nSystem UI typography is intentional for Operate mode, with Read behavior inside lessons. Color, borders, and spacing establish hierarchy without decorative elevation. The implementation uses inline SVG interface icons; existing PNG app icons predate this task and remain unchanged. No generated raster imagery shipped in this redesign.",
    "keyCharacteristics": [
      "Persistent navigation and visible selection.",
      "Flat surfaces with tonal separation.",
      "Readable instructions and source attribution.",
      "Brief motion with an explicit off control."
    ],
    "rules": [],
    "dos": [
      "Do preserve visible selected, hover, and keyboard-focus states.",
      "Do keep original-source credits beside adapted lessons.",
      "Do honor both the motion toggle and the operating-system reduced-motion preference.",
      "Do use the system UI stack consistently for operational controls and reading."
    ],
    "donts": [
      "Don’t add shadows to the current flat surface system without a deliberate design change.",
      "Don’t use animation to delay access to a control or instruction.",
      "Don’t present Toolkit adaptations as upstream authorship."
    ]
  }
