  "narrative": {
    "northStar": "The Focused Workspace",
    "overview": "Fresh Studio uses deep teal navigation, a cream workspace, mint guidance panels, and coral selected actions. Dark coral keeps small interactive text readable. The focused workspace uses deep teal for orientation, mint for selection and guided starting points, and mint for small identity and learning cues. Its character is calm, direct, and practical: clear controls surround a generous working surface.\n\nSystem UI typography is intentional for Operate mode, with Read behavior inside lessons. Color, borders, and spacing establish hierarchy without decorative elevation. The implementation uses inline SVG interface icons; Spark X is the approved identity, implemented in SVG with matching rendered PNG app icons.",
    "keyCharacteristics": [
      "Persistent navigation and visible selection.",
      "Flat surfaces with tonal separation.",
      "Readable instructions and source attribution.",
      "Brief motion with an explicit off control."
    ],
    "rules": [],
    "dos": [
      "Do preserve visible selected, hover, and keyboard-focus states.",
      "Do keep original-source credits beside adapted lessons.",
      "Do honor both the motion toggle and the operating-system reduced-motion preference.",
      "Do use the system UI stack consistently for operational controls and reading."
    ],
    "donts": [
      "Don\u2019t add shadows to the current flat surface system without a deliberate design change.",
      "Don\u2019t use animation to delay access to a control or instruction.",
      "Don\u2019t present Toolkit adaptations as upstream authorship."
    ]
  }
